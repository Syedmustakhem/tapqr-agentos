# ============================================================
# TapQR AgentOS MCP Server
# ============================================================

PORT=3000
HOST=127.0.0.1

# Existing TapQR backend
TAPQR_API_BASE_URL=http://localhost:5000

# Development-only authentication token.
#
# IMPORTANT:
# This is temporary for Phase 2 local integration.
# Production Alexa+/remote authentication will be implemented
# in the security/authentication phases.
TAPQR_API_TOKEN=

# Request timeout in milliseconds
TAPQR_API_TIMEOUT_MS=10000

# AgentOS environment
NODE_ENV=development