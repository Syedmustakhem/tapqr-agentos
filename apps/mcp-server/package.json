{
  "name": "@tapqr/agentos-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "TapQR AgentOS MCP server for autonomous QR growth workflows.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "latest",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "26.6.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}